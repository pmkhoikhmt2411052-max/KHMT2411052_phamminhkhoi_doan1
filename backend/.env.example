# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Bắt buộc khi chạy `prisma db seed` để tạo mật khẩu admin.
# Không dùng giá trị mặc định trong code; hãy đặt mật khẩu riêng.
SEED_ADMIN_PASSWORD="change-me"

# Khóa ký JWT (tối thiểu 16 ký tự). Chỉ đặt trong .env, không commit.
JWT_SECRET="replace-with-a-long-random-secret"
# Thời hạn token, ví dụ: 1d, 12h, 3600s
JWT_EXPIRES_IN="1d"

# Cổng lắng nghe của API (không bắt buộc, mặc định 3000)
PORT=3000

# Cấu hình POS/điểm (không bắt buộc, có giá trị mặc định như dưới).
# 1 điểm cho mỗi 10.000đ trên tong_tien, làm tròn xuống.
POS_DIEM_MOI_TIEN=10000
# 1 điểm = 100đ khi dùng.
POS_GIA_TRI_DIEM=100
# Múi giờ cho ma_dh và so sánh ngày voucher.
POS_TIMEZONE="Asia/Ho_Chi_Minh"
